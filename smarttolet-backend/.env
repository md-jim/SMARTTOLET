package main

import (
	"fmt"
	"log"
	"net/http"
	"smarttolet-backend/config"
	"smarttolet-backend/controllers"
)

func corsMiddleware(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Access-Control-Allow-Origin", "*")
		w.Header().Set("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS")
		w.Header().Set("Access-Control-Allow-Headers", "Content-Type, Authorization")
		if r.Method == "OPTIONS" {
			w.WriteHeader(http.StatusOK)
			return
		}
		next(w, r)
	}
}

func main() {
	// Load env
	config.LoadEnv()
	
	// Connect to database
	config.ConnectDB()
	defer config.DB.Close()

	// Routes
	http.HandleFunc("/api/auth/register", corsMiddleware(controllers.Register))
	http.HandleFunc("/api/auth/login", corsMiddleware(controllers.Login))
	http.HandleFunc("/api/profile", corsMiddleware(controllers.GetProfile))

	// Home route
	http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.Write([]byte(`{"message": "SmarTOlet API Running!"}`))
	})

	fmt.Println("========================================")
	fmt.Println("🚀 Server starting on http://localhost:8080")
	fmt.Println("📋 Auth Endpoints:")
	fmt.Println("   POST   /api/auth/register")
	fmt.Println("   POST   /api/auth/login")
	fmt.Println("   GET    /api/profile")
	fmt.Println("========================================")
	
	log.Fatal(http.ListenAndServe(":8080", nil))
}